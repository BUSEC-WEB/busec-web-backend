DATABASE_CONNECTION_STRING=postgresql://user:password@localhost:5432/busec
DEBUG=true
SECRET_KEY=change-me
SECURE_MODE=false # true in production
ALLOWED_HOSTS=[] # hostname specific
CORS_ALLOWED_ORIGINS=[] # client specific
# S3-compatible storage (MinIO in dev).
S3_ENDPOINT=localhost:9000
S3_SECURE=false
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_MAGAZINE_BUCKET=busec-blog-magazines
S3_COVER_IMAGE_BUCKET=busec-blog-cover-images